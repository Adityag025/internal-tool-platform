{
  "family": "tool-registry",
  "requiresCompatibilities": ["FARGATE"],
  "networkMode": "awsvpc",
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/toolRegistryExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/toolRegistryTaskRole",
  "containerDefinitions": [
    {
      "name": "tool-registry",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/tool-registry:VERSION",
      "essential": true,
      "portMappings": [
        { "containerPort": 8081, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SERVER_PORT",          "value": "8081" },
        { "name": "ARTIFACT_STORE",       "value": "filesystem" },
        { "name": "ARTIFACT_ROOT",        "value": "/var/lib/tool-platform/artifacts" },
        { "name": "LOG_LEVEL",            "value": "INFO" },
        { "name": "CORS_ALLOWED_ORIGINS", "value": "https://tool-platform.example.com" }
      ],
      "secrets": [
        { "name": "DB_URL",      "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/tool-registry/db-url" },
        { "name": "DB_USERNAME", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/tool-registry/db-username" },
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/tool-registry/db-password" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -q -O- http://localhost:8081/actuator/health/readiness || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tool-registry",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "mountPoints": [
        { "sourceVolume": "artifacts", "containerPath": "/var/lib/tool-platform/artifacts" }
      ],
      "stopTimeout": 30
    }
  ],
  "volumes": [
    { "name": "artifacts" }
  ]
}
