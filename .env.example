# Copy to .env and adjust. .env is gitignored - real credentials never enter git.
#   cp .env.example .env

POSTGRES_DB=toolplatform
POSTGRES_USER=toolplatform
POSTGRES_PASSWORD=localdev
# Host-side port; 5432 is already taken on this machine
POSTGRES_HOST_PORT=5433

# Consumed by the Spring Boot app (see backend/src/main/resources/application.yml)
DB_URL=jdbc:postgresql://localhost:5433/toolplatform
DB_USERNAME=toolplatform
DB_PASSWORD=localdev
SERVER_PORT=8081
LOG_LEVEL=INFO

# ---- Artifactory (only needed with --profile artifactory) ----
# Generate your own:  openssl rand -hex 32
ARTIFACTORY_MASTER_KEY=replace-me-with-64-hex-chars
ARTIFACTORY_JOIN_KEY=replace-me-with-64-hex-chars
ARTIFACTORY_HOST_PORT=8182
ARTIFACTORY_URL=http://localhost:8182
ARTIFACTORY_REPO=internal-tools-local
ARTIFACTORY_USERNAME=admin
ARTIFACTORY_PASSWORD=password
